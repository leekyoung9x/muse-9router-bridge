# Copy to config.env and edit, then reference from your systemd unit:
#   EnvironmentFile=/opt/muse-bridge/config.env
#
# All values are optional — the defaults below are what the code uses.

# ---------- adapter ----------
# Upstream API base (no trailing slash, no /v1)
MUSE_UPSTREAM=https://api.meta.ai

# Seconds before a hung upstream becomes a clean JSON 504.
# api.meta.ai sometimes accepts a request and never answers for ~300s.
MUSE_UPSTREAM_TIMEOUT=180

# Namespace wrapper Meta requires around flat function tools.
# The name is arbitrary; "client" is what we ship. Tool names come back as
# "<name>.<tool>" and the adapter strips the prefix again.
MUSE_NS_NAME=client
MUSE_NS_DESC=Client tool set.

# Outbound User-Agent. Only cosmetic — it does NOT affect the attestation gate.
MUSE_UA=muse-build/1.4.14 (non-interactive; linux-x86_64; build dec7d7497fecdad135ec5835a8161dbc92e55b58)

# Where Meta's original reasoning + function_call items are remembered so they can
# be replayed. Required for tool calls to keep real arguments. Deleting it is safe.
MUSE_CALL_CACHE=/opt/muse-bridge/call_cache.sqlite

# Prompt-cache slot isolation. 9router forwards no prompt_cache_key, so without this
# every session shares Meta's default slot and concurrent sessions evict each other
# (identical prefixes alternate hit/miss). 1 = derive a stable per-session key from
# session-anchored content (first input item never changes within a session).
# 0 = leave the field untouched.
MUSE_SESSION_KEY=1

# Tool-call replay age cap (seconds). Meta expires reasoning encrypted_content;
# replaying dead chain links breaks follow-up calls, so entries older than this
# are skipped (the call is then dropped rather than replayed empty).
MUSE_REPLAY_MAX_AGE=2700

# Request log (one line per request, with the transformations applied).
MUSE_ADAPTER_LOG=/opt/muse-bridge/adapter.log

# DEBUG ONLY: write every request body to this directory. Leave unset in normal use.
# MUSE_DUMP_DIR=/tmp/adapter-dumps

# ---------- gateway (Muse Code CLI only) ----------
MUSE_GW_UPSTREAM=http://127.0.0.1:20127
MUSE_GW_KEY_FILE=/opt/muse-bridge/9router.key
MUSE_GW_LOG=/opt/muse-bridge/gateway.log
# MUSE_GW_KEY=            # inline fallback if you cannot use a key file
